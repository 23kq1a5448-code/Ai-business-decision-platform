# Database Configuration
DATABASE_URL=sqlite:///./business_platform.db
# For PostgreSQL production: DATABASE_URL=postgresql://user:password@localhost:5432/business_platform

# JWT Secret Key (generate a strong random string in production)
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
FRONTEND_URL=http://localhost:5173

# LLM API Configuration (Optional - rule-based fallback if not configured)
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Or use another provider
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-opus-20240229

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx

# Environment
ENVIRONMENT=development
DEBUG=true

# Email Configuration (Optional for alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Redis (Optional for caching/queue)
REDIS_URL=
